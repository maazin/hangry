# Copy to .env for local work. In production these are set on the host
# (`fly secrets set …`), never committed.

# Managed Postgres hands this over as postgres://, app/config.py rewrites it
# to the asyncpg driver, so paste the platform's value unchanged.
DATABASE_URL=postgresql+asyncpg://hangry:hangry@localhost:5433/hangry

# Comma-separated. Must include the deployed web origin, or every browser
# request fails CORS and the app looks like it's down.
CORS_ORIGINS=http://localhost:3000

# Overpass is free and keyless. Raise the timeout before a cold region's
# first solve if tiles are slow to warm.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_S=30
TILE_TTL_DAYS=30

SESSION_TTL_HOURS=24
CANDIDATE_TARGET=8
CANDIDATE_MINIMUM=3
