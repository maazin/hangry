# Copy to .env.local for local work. In production these are set in the
# Vercel project's environment variables.

# Where the browser reaches the API. Baked in at BUILD time because it is
# NEXT_PUBLIC_*, so changing it in Vercel requires a redeploy, not a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# This app's own public origin, used to make Open Graph URLs absolute.
# On Vercel it is inferred from VERCEL_PROJECT_PRODUCTION_URL, so you only
# need to set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://hangry.example.com
